# Worker env. Copy to .env and set values.
#   cp env.template .env

# DB (same as API)
WORKER_DATABASE_URL=postgresql+asyncpg://app:app@localhost:5433/multi_asset_invest

# Redis queue
WORKER_REDIS_URL=redis://localhost:6380/0

# Log level: DEBUG, INFO, WARNING, ERROR
WORKER_LOG_LEVEL=INFO

# Robots cache: file (default) or redis. Path used when backend=file.
# With multiple crawl workers, redis is recommended to avoid file contention.
# WORKER_ROBOTS_CACHE_BACKEND=file
# WORKER_ROBOTS_CACHE_PATH=data/robots_cache.json

# Crawl worker processes (multiprocessing). Main process stays non-blocking.
# WORKER_CRAWL_WORKER_COUNT=2

# For crawl sources with render_mode=browser (JS-rendered pages), install Chromium once:
#   uv run playwright install chromium

# Event extractor LLM fallback (optional). If set, uncertain events are reclassified via OpenAI.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
